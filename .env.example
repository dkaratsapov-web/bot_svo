# --- MAX Bot API ---
BOT_TOKEN=
API_BASE_URL=https://platform-api2.max.ru

# webhook | polling  (webhook обязателен для production)
MODE=polling
WEBHOOK_URL=https://bot.example.ru/max/webhook
WEBHOOK_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Путь, по которому aiohttp принимает вебхук (совпадает с "хвостом" WEBHOOK_URL)
WEBHOOK_PATH=/max/webhook

# --- Хранилища ---
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# FSM-хранилище: redis://... для prod, пусто -> MemoryContext (dev)
REDIS_URL=redis://localhost:6379/0

# --- Доступ операторов/админов ---
# Список max_user_id через запятую
ADMIN_USER_IDS=123456,234567

# Чаты для уведомлений операторов (chat_id в MAX)
ADMIN_CHAT_DEFAULT_ID=
ADMIN_CHAT_JOIN_ID=
ADMIN_CHAT_JOB_ID=
ADMIN_CHAT_PSY_ID=
ADMIN_CHAT_LAW_ID=
ADMIN_CHAT_OTHER_ID=

# --- Контакты организации (для /help и кнопок) ---
ORG_PHONE=
ORG_EMAIL=
ORG_SITE_URL=
PRIVACY_POLICY_URL=

# --- Поведение ---
CONSENT_VERSION=1.0
DUPLICATE_WINDOW_HOURS=24
ASK_FREE_TEXT_FOR_OTHER=false
RESPONSE_SLA_DAYS=3

# --- Инфраструктура ---
LOG_LEVEL=INFO
TZ=Europe/Moscow
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
